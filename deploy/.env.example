# Copy this file to .env (same directory) and fill in the required values.
#
#   PowerShell:  Copy-Item -LiteralPath '.env.example' -Destination '.env'
#   bash:        cp .env.example .env
#
# Only three values are required to start the stack:
#   POSTGRES_PASSWORD, COOKFULLY_SECRET_KEY, COOKFULLY_OWNER_BOOTSTRAP_PASSWORD
# Everything else has a working local default.
#
# Never commit the real .env. This file is the safe, secret-free template.

# ---------------------------------------------------------------------------
# Required — generate your own values, do not reuse these examples
# ---------------------------------------------------------------------------

# Database password. Any value; keep it private.
POSTGRES_PASSWORD=replace-with-a-random-database-password

# Application secret used for session signing and encrypted diagnostics.
# At least 32 characters. Generate with:
#   PowerShell: [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   bash:       openssl rand -hex 32
COOKFULLY_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Password Cookfully assigns to the single owner account at first API startup.
# The owner email defaults to owner@example.com (see COOKFULLY_OWNER_EMAIL).
COOKFULLY_OWNER_BOOTSTRAP_PASSWORD=replace-with-a-strong-bootstrap-password

# ---------------------------------------------------------------------------
# Optional — defaults shown are fine for a local trial
# ---------------------------------------------------------------------------

# All persistent state is a normal folder on this computer, never a Docker
# named volume. Leave the default to use <repo>/data, or set an absolute path
# on a durable local disk, for example: COOKFULLY_DATA_ROOT=D:/Cookfully
# COOKFULLY_DATA_ROOT=../data
# Daily schedule in UTC (HH:MM, 24-hour clock).
# COOKFULLY_DATABASE_BACKUP_SCHEDULE=02:00
# COOKFULLY_DATABASE_BACKUP_RETENTION_COUNT=14

# POSTGRES_DB=cookfully
# POSTGRES_USER=cookfully
# COOKFULLY_ENVIRONMENT=development
# COOKFULLY_OWNER_EMAIL=owner@example.com
# COOKFULLY_PUBLIC_BASE_URL=http://localhost:8080
# COOKFULLY_API_BASE_URL=http://localhost:8080
# COOKFULLY_COOKIE_SECURE=false
# COOKFULLY_SESSION_TTL_DAYS=400
# COOKFULLY_TRUSTED_PROXY_CIDRS=
# COOKFULLY_FAILED_IMPORT_DIAGNOSTICS_ENABLED=false
# COOKFULLY_RETENTION_SWEEP_INTERVAL_SECONDS=21600
# COOKFULLY_BACKUP_RETENTION_DAYS=30
# COOKFULLY_SEMANTIC_MATCHING_BACKEND=hashing
# COOKFULLY_SEMANTIC_MATCHING_MODEL=BAAI/bge-small-en-v1.5
# COOKFULLY_SEMANTIC_MATCHING_MODEL_DIR=semantic-models
# COOKFULLY_WORKER_MAX_CONCURRENCY=4
# COOKFULLY_DATABASE_POOL_SIZE=10
# COOKFULLY_DATABASE_MAX_OVERFLOW=20
# COOKFULLY_DATABASE_POOL_TIMEOUT_SECONDS=30
# COOKFULLY_DATABASE_POOL_RECYCLE_SECONDS=1800
# Local model service. The default Compose key is only for development.
# COOKFULLY_INTELLIGENCE_ENABLED=true
# COOKFULLY_INTELLIGENCE_URL=http://intelligence:8091
# COOKFULLY_INTELLIGENCE_SERVICE_KEY=replace-with-a-random-intelligence-key
# COOKFULLY_INTELLIGENCE_MODEL=needle2
# COOKFULLY_INTELLIGENCE_INLINE_ENABLED=true
# COOKFULLY_INTELLIGENCE_INLINE_THRESHOLD=0.80
# COOKFULLY_INTELLIGENCE_INLINE_TIMEOUT_MS=600
# COOKFULLY_INTELLIGENCE_TIMEOUT_SECONDS=2
