# Cookfully release setup
# Copy this file to .env, then replace the three secret placeholders.
# Keep .env private; it contains credentials.

# Required on first start
POSTGRES_PASSWORD=replace-with-a-random-database-password
COOKFULLY_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
COOKFULLY_OWNER_BOOTSTRAP_PASSWORD=replace-with-a-strong-password-at-least-12-characters

# Durable host storage. Every database, photo, model, export, backup, and
# erasure-ledger file is stored below this folder.
COOKFULLY_DATA_ROOT=../data

# The web container listens on 8080 internally. Change this host port if 8080
# is already used by another app (for example, 5050).
# COOKFULLY_WEB_PORT=5050

# Optional: set these when people will open Cookfully from another device.
# Use one canonical URL, such as a LAN address or Tailscale MagicDNS name.
# COOKFULLY_PUBLIC_BASE_URL=http://cookfully.example:8080
# COOKFULLY_API_BASE_URL=http://cookfully.example:8080
# COOKFULLY_COOKIE_SECURE=false

# Optional: the first owner account uses this email. It can be omitted to use
# owner@example.com. Nutrition matching is configured after sign-in under
# Settings > Intelligence; it is intentionally not an environment setting.
# COOKFULLY_OWNER_EMAIL=owner@example.com

# Optional remote recipe-cleanup fallback. Local Needle2 remains the default;
# this is used only when enabled under Settings and local cleanup fails.
# COOKFULLY_OPENROUTER_API_KEY=
# COOKFULLY_OPENROUTER_MODEL=
